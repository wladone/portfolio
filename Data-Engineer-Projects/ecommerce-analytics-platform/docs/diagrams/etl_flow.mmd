    A --> STG_ORD --> DEDUP_ORD --> F
    B --> STG_CUST --> DEDUP_CUST --> D1
    C --> STG_PROD --> DEDUP_PROD --> D2

    SEED[Seed Scripts] --> D3
    SEED --> D4
    SEED --> AUD

    D1 --> F
    D2 --> F
    D3 --> F
    D4 --> F

    F --> V1
    F --> V2

    V1 --> Consumers[(APIs and Dashboards)]
    V2 --> Recs[(ALS Training)]

    ETL[[Batch ETL Jobs]] -.-> AUD
