APP_ENV=dev
APP_LOG_LEVEL=INFO

# Notes: For Docker Compose use service names (postgres, redis, minio, redpanda).
# For local development, replace those with 'localhost' if you're running services locally.

# Database
# - Docker: DATABASE_HOST=postgres
# - Local : DATABASE_HOST=localhost
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=app
DATABASE_PASSWORD=app_password
DATABASE_NAME=ecom
# Example SQLAlchemy URL (change host to 'postgres' when using Docker Compose)
DATABASE_URL=postgresql+psycopg://app:app_password@localhost:5432/ecom

# Redis
# - Docker: redis://redis:6379/0
# - Local : redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# MinIO
# - Docker: http://minio:9000
# - Local : http://localhost:9000
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

JWT_SECRET=change_me_in_local_only
JWT_ALG=HS256
PROMETHEUS_NAMESPACE=ecom_analytics
AUTH_REQUIRE_AUTH=false
AUTH_DEV_USERS_ENABLED=true
AUTH_ACCESS_TOKEN_EXPIRES_SECONDS=3600
CDC_STRATEGY_CUSTOMERS=watermark
CDC_STRATEGY_PRODUCTS=watermark
CDC_TS_FIELD_CUSTOMERS=updated_at
CDC_TS_FIELD_PRODUCTS=updated_at
CDC_TS_FIELD_ORDERS=transaction_ts
CDC_DEFAULT_WATERMARK_OFFSET_DAYS=0
CDC_BATCH_SIZE=5000
CACHE_INVALIDATION_STRATEGY=namespace
CACHE_NAMESPACE_SALES_KEY=ns:sales
CACHE_NAMESPACE_RECS_KEY=ns:recs
CACHE_PUBSUB_CHANNEL=cache:invalidate
CACHE_SELECTIVE_ENABLED=false
CACHE_MAX_DELETE_BATCH=1000

STREAMING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
STREAMING_KAFKA_TOPIC_ORDERS=orders
STREAMING_KAFKA_TOPIC_CUSTOMERS=customers
STREAMING_KAFKA_TOPIC_PRODUCTS=products
STREAMING_KAFKA_GROUP_ID=streaming_group
STREAMING_BATCH_SIZE=100
STREAMING_POLL_TIMEOUT_MS=1000
